{
  "name": "idem",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "IDEM: LLM tool calls as named, signed data (EEL878 research prototype).",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@idem/web",
    "build": "turbo run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "sim": "pnpm --filter @idem/sim run cli",
    "exp:e1": "pnpm sim -- --config experiments/configs/e1-node.json",
    "exp:all": "bash experiments/run-all.sh",
    "exp:ndn": "bash experiments/ndn/nfd/run.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "tsdown": "0.23.7",
    "turbo": "2.11.11",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
