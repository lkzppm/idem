{
  "name": "@idem/mcp",
  "version": "0.0.0",
  "description": "IDEM for MCP (SDK v2, spec 2026-07-28): serve an IDEM producer as an MCP server, run an IDEM edge as a transparent MCP endpoint, and verify signed tool results on the client.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@idem/core": "workspace:*",
    "@idem/gateway": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  }
}
