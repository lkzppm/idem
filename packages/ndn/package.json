{
  "name": "@idem/ndn",
  "version": "0.0.0",
  "description": "IDEM native NDN binding: IDEM names, Interests and signed Data as NDN TLV packets (NDNts), with a producer and a consumer that reuse @idem/core. Runs in Node and browsers.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@idem/core": "workspace:*",
    "@ndn/endpoint": "0.0.20260427",
    "@ndn/fw": "0.0.20260427",
    "@ndn/keychain": "0.0.20260427",
    "@ndn/packet": "0.0.20260427",
    "@ndn/tlv": "0.0.20260427"
  }
}
