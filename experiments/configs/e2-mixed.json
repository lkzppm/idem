{
  "experiment": "e2-mixed",
  "kind": "sweep",
  "title": "E2 \u2014 non-cacheable and private calls under load (W-mixed)",
  "description": "W-mixed at the base workload: 10% of the calls go to the private tool my_notes, and the swept fraction goes to the side-effecting tool send_email (never cacheable, passthrough). Checks bypass and scope behavior under load. Same seeds at every point; reductions are paired by seed against B0 (and B1).",
  "seeds": {
    "first": 1,
    "count": 30
  },
  "modes": ["B0", "B1", "B2", "B3"],
  "sweep": {
    "param": "sideEffectFraction",
    "values": [0, 0.1, 0.2, 0.4]
  },
  "base": {
    "workload": {
      "agents": 8,
      "callsPerAgent": 20,
      "catalogSize": 50,
      "zipfAlpha": 0.8,
      "overlap": 0.5,
      "thinkTimeMs": 2000,
      "surfaceVariation": 0.3,
      "privateFraction": 0.1,
      "sideEffectFraction": 0
    },
    "topology": {
      "agentLinkMs": 5,
      "producerLinkMs": 40,
      "lossPct": 0,
      "tree": {
        "edges": 2,
        "coreLinkMs": 10,
        "producerLinkMs": 30
      }
    },
    "producer": {
      "serviceMedianMs": 150,
      "serviceSigma": 0.5,
      "ttlMs": 60000,
      "pageBytesMedian": 6144
    },
    "cs": {
      "maxBytes": 8388608,
      "policy": "lru"
    },
    "interestLifetimeMs": 10000
  },
  "processing": "processing.json"
}
